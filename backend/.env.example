# 12+ characters, uppercase, lowercase and a number. No built-in password.
DEMO_PASSWORD=

# Optional SMTP password reset delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
