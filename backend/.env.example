NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/attendly?replicaSet=rs0&directConnection=true
AUTH_SECRET=CHANGE_AUTH_SECRET
QR_SECRET=CHANGE_QR_SECRET
