{
  "name": "attendly",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "test": "npm test -w backend",
    "seed": "npm run seed -w backend",
    "bootstrap": "npm run bootstrap -w backend",
    "test:unit": "npm run test:unit -w backend",
    "test:integration": "npm run test:integration -w backend",
    "setup": "node scripts/setup.mjs",
    "format": "prettier --write \"backend/src/**/*.js\" \"backend/test/**/*.js\" \"frontend/src/**/*.{jsx,js,css}\" \"*.{json,md,yml}\" \"docs/*.md\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  }
}
